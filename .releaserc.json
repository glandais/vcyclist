{
  "branches": [
    "develop"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/^version=.*/version=${nextRelease.version}/' gradle.properties",
        "publishCmd": "./gradlew :cli:executableJar :engine:publishAndReleaseToMavenCentral :gpx:publishAndReleaseToMavenCentral :elevation:publishAndReleaseToMavenCentral :fit:publishAndReleaseToMavenCentral :map:publishAndReleaseToMavenCentral :engine:npmPublishJs :elevation:npmPublishJs --no-configuration-cache"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "gradle.properties",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "cli/build/libs/vcyclist-cli-*-all.jar",
            "label": "vcyclist-cli ${nextRelease.version} (executable jar, Java 21+)"
          },
          {
            "path": "engine/build/wasm/vcyclist-engine.wasm",
            "label": "vcyclist-engine.wasm ${nextRelease.version} (standalone WASI module)"
          },
          {
            "path": "engine/build/wasm/vcyclist-engine.wasm.sha256",
            "label": "vcyclist-engine.wasm.sha256 ${nextRelease.version}"
          }
        ]
      }
    ]
  ]
}
